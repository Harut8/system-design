// Golden set v1 — hand-authored, chunking-independent source of truth.
// One JSON object per line. `//` comments and blank lines are ignored.
//
// Fields:
//   id               stable, never reused, never renumbered (labels are cited by id)
//   query            what a real user would type, not a keyword bag
//   expected_answer  the fact, short enough to grade against
//   locators         [{doc, quote}] — `quote` must be an EXACT substring of the doc,
//                    on ONE line, and unique within that doc. The builder resolves it
//                    to char offsets and expands to the enclosing paragraph block.
//   hop              "single" | "multi" — multi means the answer needs every span
//   tags             free-form; used to check the set isn't 90% one question shape
{"id": "q0001", "query": "What is the upper bound on how often a RAG pipeline can be correct?", "expected_answer": "P(correct answer) <= P(evidence retrieved) x P(model uses it correctly | retrieved) — retrieval caps end-to-end correctness.", "locators": [{"doc": "00-mental-models.md", "quote": "P(correct answer) ≤ P(evidence retrieved) × P(model uses it correctly | retrieved)"}], "hop": "single", "tags": ["eval", "retrieval"]}
{"id": "q0002", "query": "If retrieval recall at my shipped context budget is 0.6, how much can prompt engineering help?", "expected_answer": "It cannot exceed 0.6 end-to-end; the retrieval term caps the product, so prompt work on a retrieval-broken query cannot fix it.", "locators": [{"doc": "00-mental-models.md", "quote": "if retrieval recall at your context budget is 0.6"}], "hop": "single", "tags": ["eval", "retrieval"]}
{"id": "q0003", "query": "How do I tell whether a wrong answer is a retrieval problem or a generation problem?", "expected_answer": "Run the oracle-context test: hand the known-correct chunk to the generator, bypassing retrieval. Still wrong = generation (class d); now correct = the failure was upstream.", "locators": [{"doc": "00-mental-models.md", "quote": "Bypass retrieval entirely: construct"}], "hop": "single", "tags": ["diagnosis"]}
{"id": "q0004", "query": "Why must the oracle-context harness look chunks up by id instead of calling the retriever?", "expected_answer": "Routing through the retriever makes it a retrieval test, not an oracle test — the direct lookup is what removes retrieval as a variable.", "locators": [{"doc": "00-mental-models.md", "quote": "That's what makes it an *oracle*"}], "hop": "single", "tags": ["diagnosis", "eval"]}
{"id": "q0005", "query": "What k values should the recall sweep use?", "expected_answer": "k in {1, 5, 10, 20, 50}, checked before reranking and budget truncation.", "locators": [{"doc": "00-mental-models.md", "quote": "sweep k — 1, 5, 10,"}], "hop": "single", "tags": ["eval"]}
{"id": "q0006", "query": "What are the four failure classes a wrong RAG answer factors into?", "expected_answer": "(a) not in corpus, (b) in corpus but not retrievable, (c) retrieved but ranked out of the context budget, (d) in context but unused/misread.", "locators": [{"doc": "00-mental-models.md", "quote": "Retrieved but ranked out of the context budget"}], "hop": "single", "tags": ["diagnosis"]}
{"id": "q0007", "query": "Which metric distinguishes a document that was never ingested from one that was ingested but is unrankable?", "expected_answer": "Recall@k stays at zero at every k for a not-in-corpus failure; confirm by grepping the raw corpus for the answer text.", "locators": [{"doc": "00-mental-models.md", "quote": "recall@k stays at zero for this query no matter how high you push k"}], "hop": "single", "tags": ["diagnosis", "eval"]}
{"id": "q0008", "query": "When a query has several answer-bearing chunks, how should recall@k be defined?", "expected_answer": "Decide up front whether a hit means any answer-bearing chunk or all of them; multi-hop questions need the strict all rule, and the definition must be written next to the number.", "locators": [{"doc": "00-mental-models.md", "quote": "count as a hit if *any* answer-bearing chunk is retrieved"}], "hop": "single", "tags": ["eval"]}
{"id": "q0009", "query": "Is the embedding model a config value I can change later?", "expected_answer": "No — it is part of the index's schema, not a runtime parameter; changing it invalidates every vector and forces a full rebuild.", "locators": [{"doc": "00-mental-models.md", "quote": "the embedding model is part of the index's schema"}], "hop": "single", "tags": ["embeddings", "ops"]}
{"id": "q0010", "query": "What does OpenAI charge for text-embedding-3-small?", "expected_answer": "$0.02 per million tokens (checked 2026-08-08); 3-large is $0.13/M and legacy ada-002 is $0.10/M.", "locators": [{"doc": "00-mental-models.md", "quote": "`text-embedding-3-small` is **$0.02 per million"}], "hop": "single", "tags": ["cost", "embeddings"]}
{"id": "q0011", "query": "Why is staying on ada-002 a cost bug and not just a quality one?", "expected_answer": "It scores worse on OpenAI's own MTEB numbers (61.0% vs 62.3%) while costing five times more than text-embedding-3-small.", "locators": [{"doc": "00-mental-models.md", "quote": "61.0% vs. 3-small's 62.3%"}], "hop": "single", "tags": ["cost", "embeddings"]}
{"id": "q0012", "query": "What does Anthropic's contextual retrieval cost per million document tokens?", "expected_answer": "$1.02 per million document tokens, one-time at ingest, and only that cheap because of prompt caching.", "locators": [{"doc": "00-mental-models.md", "quote": "published figure for that step is"}], "hop": "single", "tags": ["cost", "ingest"]}
{"id": "q0013", "query": "Which term dominates per-query cost in a real RAG system?", "expected_answer": "Generator input tokens — the retrieved context you stuffed into the prompt — which makes retrieval precision a cost lever, not only a quality lever.", "locators": [{"doc": "00-mental-models.md", "quote": "the dominant per-query cost in almost every real RAG system is generator input tokens"}], "hop": "single", "tags": ["cost"]}
{"id": "q0014", "query": "How is total query latency composed across retrieval stages?", "expected_answer": "Roughly t_embed_q + max(t_ann, t_sparse) + t_fuse + t_rerank + t_assemble + t_ttft + t_decode, with the sparse and dense probes overlapping if run concurrently.", "locators": [{"doc": "00-mental-models.md", "quote": "max(t_ann, t_sparse)"}], "hop": "single", "tags": ["latency"]}
{"id": "q0015", "query": "Should I set my latency SLO on end-to-end time or on time to first token?", "expected_answer": "On TTFT (plus a p95/p99 end-to-end tail) — with streaming, TTFT is the number the user actually feels.", "locators": [{"doc": "00-mental-models.md", "quote": "TTFT specifically, not end-to-end latency"}], "hop": "single", "tags": ["latency", "ops"]}
{"id": "q0016", "query": "Why not run the cross-encoder over the whole corpus?", "expected_answer": "Cost per query is the sum over stages of cost-per-candidate times candidates examined, so the cheap stage must examine many candidates and the expensive one few.", "locators": [{"doc": "00-mental-models.md", "quote": "cost_per_query ≈ Σ_stages"}], "hop": "single", "tags": ["retrieval", "cost"]}
{"id": "q0017", "query": "What is context rot?", "expected_answer": "The accepted term for model quality degrading as context grows, even when every added token is nominally relevant — which is why stuffing the whole corpus in is not a free win.", "locators": [{"doc": "00-mental-models.md", "quote": "is **context rot**"}], "hop": "single", "tags": ["context"]}
{"id": "q0018", "query": "For agent conversation history, is similarity search the right retrieval signal?", "expected_answer": "Usually not — recency is; you often need the last 50 turns, not the most semantically similar 50 turns.", "locators": [{"doc": "00-mental-models.md", "quote": "you often need the last 50 turns, not the most semantically similar 50 turns"}], "hop": "single", "tags": ["agents", "retrieval"]}
{"id": "q0019", "query": "Why does per-user access control push a design toward retrieval rather than long context?", "expected_answer": "The index/retrieval layer is the natural place to enforce per-document permissions; instructing the prompt to ignore what the user may not see is not access control.", "locators": [{"doc": "00-mental-models.md", "quote": "the natural place to enforce per-document permissions"}], "hop": "single", "tags": ["retrieval", "security"]}
{"id": "q0020", "query": "What has to bound an agentic retrieval loop?", "expected_answer": "An explicit budget and an explicit termination condition — max tool calls, a cost ceiling, or a confidence threshold — because an unbounded self-terminating loop is a latency and cost time bomb.", "locators": [{"doc": "00-mental-models.md", "quote": "an explicit termination condition"}], "hop": "single", "tags": ["agents", "cost"]}
{"id": "q0021", "query": "Which refresh strategy fits a freshness SLO measured in minutes?", "expected_answer": "Streaming upsert — continuous O(delta) work needing a queue and idempotent writers; staleness is bounded by pipeline lag, and it is the most expensive option.", "locators": [{"doc": "00-mental-models.md", "quote": "| Streaming upsert |"}], "hop": "single", "tags": ["ingest", "ops"]}
{"id": "q0022", "query": "Why does editing one source document re-embed more than one chunk?", "expected_answer": "Write amplification: an edit shifts chunk boundaries, so every chunk downstream of it must be re-chunked and re-embedded.", "locators": [{"doc": "00-mental-models.md", "quote": "**Write amplification.**"}], "hop": "single", "tags": ["ingest", "cost"]}
{"id": "q0023", "query": "What is a packed binary vector's size in bytes?", "expected_answer": "d/8 bytes, not d bytes — the most common integration bug in binary-quantized vector databases.", "locators": [{"doc": "01-embeddings-and-representation.md", "quote": "A packed binary vector has `d/8` bytes, not `d` bytes."}], "hop": "single", "tags": ["embeddings", "quantization"]}
{"id": "q0024", "query": "How much retrieval quality survives binary quantization?", "expected_answer": "About 92.5% of float32 retrieval performance without rescoring and up to ~96% with it, on the HF 15-benchmark MTEB retrieval subset at k=100.", "locators": [{"doc": "01-embeddings-and-representation.md", "quote": "**~92.5%** of retrieval performance"}], "hop": "single", "tags": ["embeddings", "quantization"]}
{"id": "q0025", "query": "Is slicing a vector to fewer dimensions the same as PCA?", "expected_answer": "No — MRL truncation is a trained property of the model; PCA/SVD reduction is a post-hoc guess. They look like the same operation and are not.", "locators": [{"doc": "01-embeddings-and-representation.md", "quote": "MRL truncation is a trained property; PCA/SVD reduction is a post-hoc guess."}], "hop": "single", "tags": ["embeddings"]}
{"id": "q0026", "query": "After truncating an embedding, do I need to renormalize it myself?", "expected_answer": "It depends on the model: gemini-embedding-001 requires you to L2-normalize truncated dimensions manually, while other vendors do it for you — truncation un-normalizes a unit vector either way.", "locators": [{"doc": "01-embeddings-and-representation.md", "quote": "you must manually L2-normalize"}], "hop": "single", "tags": ["embeddings", "bugs"]}
{"id": "q0027", "query": "Why is MTEB contamination described as structural rather than accidental?", "expected_answer": "MTEB's retrieval tasks are backed by BEIR, whose corpora are in the training data of the models being scored, so part of the score measures memorization.", "locators": [{"doc": "01-embeddings-and-representation.md", "quote": "Contamination is structural, not accidental."}], "hop": "single", "tags": ["embeddings", "eval"]}
{"id": "q0028", "query": "Can I compare MTEB v1 and v2 scores?", "expected_answer": "No — v1 and v2 are not on the same scale, and English v2, MMTEB, and Code are separate boards.", "locators": [{"doc": "01-embeddings-and-representation.md", "quote": "MTEB versions aren't comparable to each other."}], "hop": "single", "tags": ["embeddings", "eval"]}
{"id": "q0029", "query": "Why do quantization and dimensionality reduction matter economically at scale?", "expected_answer": "Because storage, not compute, is the recurring bill — compute is one-time, storage compounds monthly for the life of the index.", "locators": [{"doc": "01-embeddings-and-representation.md", "quote": "Storage cost, not compute cost"}], "hop": "single", "tags": ["cost", "embeddings"]}
{"id": "q0030", "query": "What is lost by embedding queries and documents with the same input type?", "expected_answer": "Quality the model was explicitly trained to give you — asymmetric input types exist precisely because a query and a document are different kinds of text.", "locators": [{"doc": "01-embeddings-and-representation.md", "quote": "embedding them identically forfeits"}], "hop": "single", "tags": ["embeddings", "bugs"]}
{"id": "q0031", "query": "What does re-embedding a 500M-token corpus with text-embedding-3-large cost?", "expected_answer": "$65.00 at $0.13 per million tokens, versus $10.00 with 3-small.", "locators": [{"doc": "01-embeddings-and-representation.md", "quote": "re-embed with text-embedding-3-large: 500M × ($0.13 / 1M) = $65.00"}], "hop": "single", "tags": ["cost", "embeddings"]}
{"id": "q0032", "query": "What memory cost basis does the HF quantization blog use?", "expected_answer": "Roughly $3.8 per GB/month, from AWS x2gd memory-optimized instances.", "locators": [{"doc": "01-embeddings-and-representation.md", "quote": "$3.8 per GB/month"}], "hop": "single", "tags": ["cost"]}
{"id": "q0033", "query": "Is there any embedding model family whose vectors are comparable across tiers?", "expected_answer": "Voyage's 4-series shared space is the one documented exception; every other model boundary requires a full re-embed, and it does not extend across generations.", "locators": [{"doc": "01-embeddings-and-representation.md", "quote": "Voyage's 4-series shared space is the exception"}], "hop": "single", "tags": ["embeddings", "ops"]}
{"id": "q0034", "query": "Why is a default that silently truncates long inputs dangerous at ingest?", "expected_answer": "It is a data-loss bug wearing a config default's clothing — content is permanently written to the index minus its tail, with no error.", "locators": [{"doc": "01-embeddings-and-representation.md", "quote": "Silent truncation on ingest is a data-loss bug"}], "hop": "single", "tags": ["ingest", "bugs"]}
{"id": "q0035", "query": "What does 20% chunk overlap actually cost?", "expected_answer": "25% more chunks, tokens, and bytes — overlap costs 1/(1-f), not f — on both the one-time embedding bill and the recurring storage bill.", "locators": [{"doc": "02-chunking-and-document-processing.md", "quote": "20% overlap is 25% more chunks, tokens, and bytes, forever"}], "hop": "single", "tags": ["chunking", "cost"]}
{"id": "q0036", "query": "How should a chunk ID be computed so a small edit doesn't reprocess the whole document?", "expected_answer": "Content-addressed: hash(doc_id, chunker_version, normalized_chunk_text), so only chunks whose text changed get new IDs.", "locators": [{"doc": "02-chunking-and-document-processing.md", "quote": "hash(doc_id, chunker_version, normalized_chunk_text)"}], "hop": "single", "tags": ["chunking", "ingest"]}
{"id": "q0037", "query": "What goes wrong with position-addressed chunk IDs?", "expected_answer": "Inserting a paragraph shifts every subsequent ordinal, so every ID in the document changes and a one-word edit costs a full document reprocess.", "locators": [{"doc": "02-chunking-and-document-processing.md", "quote": "hash(doc_id, chunker_version, ordinal)"}], "hop": "single", "tags": ["chunking", "ingest"]}
{"id": "q0038", "query": "What happens if I skip deletion when reindexing a shrinking document?", "expected_answer": "The removed chunk stays retrievable and gets cited as current with a source URI that no longer contains it — confidently wrong data with a citation.", "locators": [{"doc": "02-chunking-and-document-processing.md", "quote": "Deletion is not optional and it is the step people skip."}], "hop": "single", "tags": ["ingest", "ops"]}
{"id": "q0039", "query": "What does deleting a vector cost in a graph-based index?", "expected_answer": "It is usually a tombstone: the node stays in the graph for connectivity and is filtered from results, with space reclaimed only on compaction — so churn degrades search and inflates storage.", "locators": [{"doc": "02-chunking-and-document-processing.md", "quote": "implement delete as a tombstone"}], "hop": "single", "tags": ["ingest", "ops"]}
{"id": "q0040", "query": "Why can't a golden set labelled with chunk IDs compare two chunking strategies?", "expected_answer": "Chunk IDs only exist relative to a chunking, so labels written against chunker A name nothing in chunker B's output; label spans in the canonical text instead.", "locators": [{"doc": "02-chunking-and-document-processing.md", "quote": "Chunk IDs only exist *relative to a chunking*."}], "hop": "single", "tags": ["eval", "chunking"]}
{"id": "q0041", "query": "Which hit rule is right when an answer is legitimately assembled from several chunks?", "expected_answer": "Union coverage >= tau: the coverage of the span by the union of all retrieved chunks.", "locators": [{"doc": "02-chunking-and-document-processing.md", "quote": "coverage of the span by the *union* of all retrieved chunks"}], "hop": "single", "tags": ["eval", "chunking"]}
{"id": "q0042", "query": "How is token-level IoU defined for chunking evaluation?", "expected_answer": "IoU(q) = |t_e intersect t_r| / |t_e union t_r|, over the tokens of the relevant excerpts and of all retrieved chunks.", "locators": [{"doc": "02-chunking-and-document-processing.md", "quote": "IoU(q) = |t_e ∩ t_r| / |t_e ∪ t_r|"}], "hop": "single", "tags": ["eval", "chunking"]}
{"id": "q0043", "query": "What does Precision_Omega measure?", "expected_answer": "The chunking's own ceiling with the retriever removed — how good the chunking could be if retrieval were perfect.", "locators": [{"doc": "02-chunking-and-document-processing.md", "quote": "Precision_Ω isolates the chunking from the retriever."}], "hop": "single", "tags": ["eval", "chunking"]}
{"id": "q0044", "query": "Should chunkings be compared at fixed k?", "expected_answer": "No — compare at a fixed retrieved-token budget, because k means different things at different chunk sizes.", "locators": [{"doc": "02-chunking-and-document-processing.md", "quote": "recall at a fixed retrieved-token budget"}], "hop": "single", "tags": ["eval", "chunking"]}
{"id": "q0045", "query": "Why is a result attributed to chunk size alone confounded?", "expected_answer": "Chunk size and k are one decision: changing chunk size at fixed k changes the context budget the generator sees.", "locators": [{"doc": "02-chunking-and-document-processing.md", "quote": "Chunk size and `k` are one decision."}], "hop": "single", "tags": ["chunking", "eval"]}
{"id": "q0046", "query": "Why do PDF extractors get reading order and tables wrong?", "expected_answer": "PDF is a print format — everything above the glyph level is reconstructed by heuristics, so the structure was never in the file to begin with.", "locators": [{"doc": "02-chunking-and-document-processing.md", "quote": "PDF is a print format."}], "hop": "single", "tags": ["parsing"]}
{"id": "q0047", "query": "What check catches a scanned PDF that contributed nothing to the index?", "expected_answer": "An extraction-yield assertion — a scanned PDF that extracts to the empty string produces zero vectors and zero errors.", "locators": [{"doc": "02-chunking-and-document-processing.md", "quote": "produces zero vectors and zero errors."}], "hop": "single", "tags": ["parsing", "ingest"]}
{"id": "q0048", "query": "What is the cheapest fix for a table split across several chunks?", "expected_answer": "Repeat the header row in every chunk — free, deterministic, and it turns unlabeled number grids into interpretable chunks.", "locators": [{"doc": "02-chunking-and-document-processing.md", "quote": "Repeat the header row in every chunk of a split table."}], "hop": "single", "tags": ["parsing", "chunking"]}
{"id": "q0049", "query": "In Chroma's results, how far apart are chunking strategies on recall versus precision?", "expected_answer": "Recall spans 8.3 points while precision spans 5.7x — evaluate on recall alone and you conclude chunking doesn't matter, which is a fact about the metric.", "locators": [{"doc": "02-chunking-and-document-processing.md", "quote": "the recall spread is 8.3 points and the precision spread is 5.7×."}], "hop": "single", "tags": ["chunking", "eval"]}
{"id": "q0050", "query": "How do I get small retrieval units without giving the generator fragments?", "expected_answer": "Decouple the retrieval unit from the generation unit — index small children and expand to the parent at generation time, for roughly the cost of a parent_id column.", "locators": [{"doc": "02-chunking-and-document-processing.md", "quote": "for roughly the cost of a `parent_id` column"}], "hop": "single", "tags": ["chunking", "context"]}
{"id": "q0051", "query": "What is P0 in this folder's project ladder and why is it first?", "expected_answer": "A golden query set over a real corpus with recall@k, MRR, nDCG and a faithfulness check — first because every later project needs it to prove anything at all.", "locators": [{"doc": "README.md", "quote": "A golden query set over a real corpus, with recall@k, MRR, nDCG, and a faithfulness check."}], "hop": "single", "tags": ["planning"]}
{"id": "q0052", "query": "What does P1 consist of?", "expected_answer": "Hybrid BM25 + dense retrieval with RRF fusion and a cross-encoder reranker, behind an API, benchmarked against P0.", "locators": [{"doc": "README.md", "quote": "Hybrid BM25 + dense with RRF fusion and a cross-encoder reranker, behind an API."}], "hop": "single", "tags": ["planning", "retrieval"]}
{"id": "q0053", "query": "What must accompany any accuracy or latency figure quoted from this repo?", "expected_answer": "A one-sentence account of how it was measured; if that sentence doesn't exist, cut the number.", "locators": [{"doc": "README.md", "quote": "must come with a one-sentence account of how it was"}], "hop": "single", "tags": ["planning", "eval"]}
{"id": "q0054", "query": "Is fine-tuning in scope for this folder?", "expected_answer": "No — fine-tuning, LoRA and RLHF are named as deliberately out of scope; only the decision boundary for when fine-tuning beats retrieval is studied.", "locators": [{"doc": "README.md", "quote": "**Fine-tuning, LoRA, RLHF**"}], "hop": "single", "tags": ["planning"]}
{"id": "q0055", "query": "Why one flagship project instead of five small ones?", "expected_answer": "Only a flagship survives follow-up questions; small projects show you can follow a tutorial, a system with tenants and a cost model shows you can design one.", "locators": [{"doc": "README.md", "quote": "only a flagship survives follow-up"}], "hop": "single", "tags": ["planning"]}
{"id": "q0056", "query": "What would it cost me to switch embedding models, and can I migrate gradually?", "expected_answer": "Cost scales with corpus token count (e.g. 500M tokens is $10 on 3-small, $65 on 3-large) and there is no gradual path — vectors from two models are incomparable, so you run both indexes until cutover. The one exception is Voyage's 4-series shared space, across tiers only.", "locators": [{"doc": "00-mental-models.md", "quote": "there is no\npartial migration path"}, {"doc": "01-embeddings-and-representation.md", "quote": "Voyage's 4-series shared space is the exception"}], "hop": "multi", "tags": ["embeddings", "cost", "ops"]}
{"id": "q0057", "query": "If chunk IDs can't be the ground truth in a golden set, what makes them stable enough to derive?", "expected_answer": "Label spans in the canonical text rather than chunk IDs; derive IDs from a content-addressed scheme, hash(doc_id, chunker_version, normalized_chunk_text), which changes only for chunks whose text changed.", "locators": [{"doc": "02-chunking-and-document-processing.md", "quote": "Chunk IDs only exist *relative to a chunking*."}, {"doc": "02-chunking-and-document-processing.md", "quote": "hash(doc_id, chunker_version, normalized_chunk_text)"}], "hop": "multi", "tags": ["eval", "chunking"]}
{"id": "q0058", "query": "Why is retrieving fewer, better chunks a cost decision and not just a quality one?", "expected_answer": "Generator input tokens dominate per-query cost, so every unnecessary chunk is a recurring charge — and upstream, overlap inflates the same token count by 1/(1-f) forever.", "locators": [{"doc": "00-mental-models.md", "quote": "the dominant per-query cost in almost every real RAG system is generator input tokens"}, {"doc": "02-chunking-and-document-processing.md", "quote": "20% overlap is 25% more chunks, tokens, and bytes, forever"}], "hop": "multi", "tags": ["cost", "chunking"]}
{"id": "q0059", "query": "What are the cheap and expensive ways to stop a chunk from being orphaned from its document?", "expected_answer": "Cheap: structure-aware splitting with the heading path prepended, which belongs in the baseline. Expensive: contextual retrieval, an LLM-written situating blurb per chunk at $1.02 per million document tokens.", "locators": [{"doc": "02-chunking-and-document-processing.md", "quote": "A section heading is a boundary the author already drew."}, {"doc": "00-mental-models.md", "quote": "published figure for that step is"}], "hop": "multi", "tags": ["chunking", "cost"]}
{"id": "q0060", "query": "What rung does chapter 00 sit on, and what moves its claims to rung 1?", "expected_answer": "It sits on rung 3 (studied) until the lab exercises are run; the numbers those exercises produce move to rung 1 (measured), each carrying a one-sentence account of how it was measured.", "locators": [{"doc": "00-mental-models.md", "quote": "this document itself sits on **rung 3 — studied**"}, {"doc": "README.md", "quote": "must come with a one-sentence account of how it was"}], "hop": "multi", "tags": ["planning", "eval"]}
